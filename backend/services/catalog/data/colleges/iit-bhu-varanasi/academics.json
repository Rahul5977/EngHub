  "curriculumHighlights": [
    {
      "text": "Academic year runs two regular semesters — autumn from the fourth week of July, spring from the last week of December — each about 18 weeks with two periodicals plus an end-semester exam, and an optional faster-paced summer term of roughly nine weeks.",
      "sources": [
        {
          "url": "https://www.iitbhu.ac.in/contents/institute/dean/doaa/doc/ordinance_ug_amended.pdf",
          "title": "Ordinances Governing Undergraduate Programmes",
          "publisher": "IIT (BHU) Varanasi",
          "accessedOn": "2026-09-16",
          "asOf": null,
          "confidence": "official"
        }
      ],
      "asOf": null
    },
    {
      "text": "Change of branch is a one-time option: students may apply at the end of semester II if their CPI is at least 8.0 and they have cleared every first-year course, subject to each class staying within about 10% of its sanctioned strength.",
      "sources": [
        {
          "url": "https://www.iitbhu.ac.in/contents/institute/dean/doaa/doc/ordinance_ug_amended.pdf",
          "title": "Ordinances Governing Undergraduate Programmes",
          "publisher": "IIT (BHU) Varanasi",
          "accessedOn": "2026-09-16",
          "asOf": null,
          "confidence": "official"
        }
      ],
      "asOf": null
    },
    {
      "text": "B.Tech/B.Pharm students can apply to convert into the matching 5-year Integrated Dual Degree (B.Tech-M.Tech or B.Pharm-M.Pharm) before 7th-semester registration, needing a minimum CPI of 6.5 (relaxable to 6.0 for strong research potential) and Senate approval.",
      "sources": [
        {
          "url": "https://www.iitbhu.ac.in/contents/institute/dean/doaa/doc/ordinance_ug_amended.pdf",
          "title": "Ordinances Governing Undergraduate Programmes",
          "publisher": "IIT (BHU) Varanasi",
          "accessedOn": "2026-09-16",
          "asOf": null,
          "confidence": "official"
        }
      ],
      "asOf": null
    },
    {
      "text": "A student typically registers for about 50-60 credits a semester; from the third semester DUGC approval can add a 5-10 credit research-unit overload on top of the normal load.",
      "sources": [
        {
          "url": "https://www.iitbhu.ac.in/contents/institute/dean/doaa/doc/ordinance_ug_amended.pdf",
          "title": "Ordinances Governing Undergraduate Programmes",
          "publisher": "IIT (BHU) Varanasi",
          "accessedOn": "2026-09-16",
          "asOf": null,
          "confidence": "official"
        }
      ],
      "asOf": null
    },
    {
      "text": "Performance is tracked through letter grades converted into a credit-weighted Semester Performance Index (SPI) each term and a Cumulative Performance Index (CPI) across all completed semesters.",
      "sources": [
        {
          "url": "https://www.iitbhu.ac.in/contents/institute/dean/doaa/doc/ordinance_ug_amended.pdf",
          "title": "Ordinances Governing Undergraduate Programmes",
          "publisher": "IIT (BHU) Varanasi",
          "accessedOn": "2026-09-16",
          "asOf": null,
          "confidence": "official"
        }
      ],
      "asOf": null
    },
    {
      "text": "Seventeen undergraduate departments run 4-year B.Tech programmes (including newer schools such as Biomedical Engineering, Materials Science and Pharmaceutical Engineering & Technology) alongside a 5-year B.Arch.",
      "sources": [
        {
          "url": "https://josaa.admissions.nic.in/applicant/seatmatrix/seatmatrixinfo.aspx",
          "title": "JoSAA 2026 Seat Matrix — Seat Information (Indian Institute of Technology)",
          "publisher": "JoSAA",
          "accessedOn": "2026-09-14",
          "asOf": "2026",
          "confidence": "official"
        },
        {
          "url": "https://www.iitbhu.ac.in/",
          "title": "IIT (BHU) Varanasi — home page (departments and schools)",
          "publisher": "IIT (BHU) Varanasi",
          "accessedOn": "2026-09-16",
          "asOf": null,
          "confidence": "official"
        }
      ],
      "asOf": "2026"
    }
  ],
  "research": {
    "note": "The institute's NIRF'2025 filing reports 1,123 full-time and 73 part-time Ph.D scholars (including Integrated Ph.D). In 2023-24 it ran 453 sponsored-research projects worth about Rs 44.2 crore from 100 funding agencies, and 1,354 consultancy projects worth about Rs 27.8 crore for 915 client organisations. 47 patents were granted and 49 published in calendar 2023.",
    "phdCount": 1196,
