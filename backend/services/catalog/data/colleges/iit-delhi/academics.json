  "curriculumHighlights": [
    {
      "text": "B.Tech./B.S. degrees need 142-155 credits plus 8 non-graded units across Basic Sciences, General Engineering, Departmental Core/Elective, Open Category and Humanities; B.Des needs 143 credits, and the B.Tech+M.Tech dual degree needs 178-200 credits.",
      "sources": [
        {
          "url": "https://home.iitd.ac.in/uploads/UG%20Programme%20Rules/CoS-02025-26__UG-Programme-Rules__03-02-2026.pdf",
          "title": "Courses of Study 2025-26 — Undergraduate Programme Rules",
          "publisher": "IIT Delhi",
          "accessedOn": "2026-09-16",
          "asOf": "2025-26",
          "confidence": "official"
        }
      ],
      "asOf": "2025-26"
    },
    {
      "text": "Every undergraduate must also clear 8 non-graded units: Life Skills workshops, Language and Writing Skills exercises, one unit of NCC/NSO/NSS, and Design & Practical Experience earned through internships, co-curricular projects, or hands-on courses.",
      "sources": [
        {
          "url": "https://home.iitd.ac.in/uploads/UG%20Programme%20Rules/CoS-02025-26__UG-Programme-Rules__03-02-2026.pdf",
          "title": "Courses of Study 2025-26 — Undergraduate Programme Rules",
          "publisher": "IIT Delhi",
          "accessedOn": "2026-09-16",
          "asOf": "2025-26",
          "confidence": "official"
        }
      ],
      "asOf": "2025-26"
    },
    {
      "text": "Branch change is a one-time option at the end of first year: CGPA above 8.0 (General/OBC/EWS) or 7.0 (SC/ST/PwD), all first-year credits cleared, and for the Design branch a qualifying UCEED score; transfers are capped near 15% of the target branch's sanctioned strength.",
      "sources": [
        {
          "url": "https://home.iitd.ac.in/uploads/UG%20Programme%20Rules/CoS-02025-26__UG-Programme-Rules__03-02-2026.pdf",
          "title": "Courses of Study 2025-26 — Undergraduate Programme Rules",
          "publisher": "IIT Delhi",
          "accessedOn": "2026-09-16",
          "asOf": "2025-26",
          "confidence": "official"
        }
      ],
      "asOf": "2025-26"
    },
    {
      "text": "Strong students who register for extra credits can add a Minor/Interdisciplinary Area Specialization, a Departmental Specialization (about 20 credits in a focus area), or graduate with Honours (18 extra credits); each is recorded on the degree.",
      "sources": [
        {
          "url": "https://home.iitd.ac.in/uploads/UG%20Programme%20Rules/CoS-02025-26__UG-Programme-Rules__03-02-2026.pdf",
          "title": "Courses of Study 2025-26 — Undergraduate Programme Rules",
          "publisher": "IIT Delhi",
          "accessedOn": "2026-09-16",
          "asOf": "2025-26",
          "confidence": "official"
        }
      ],
      "asOf": "2025-26"
    },
    {
      "text": "An early-exit ladder lets students leave with a Certificate of IIT Delhi (34 credits), an Associate of IIT Delhi (72 credits), or an Intermediate B.Tech (108 credits) before completing the full degree; it applies to both B.Tech and dual-degree entrants.",
      "sources": [
        {
          "url": "https://home.iitd.ac.in/uploads/UG%20Programme%20Rules/CoS-02025-26__UG-Programme-Rules__03-02-2026.pdf",
          "title": "Courses of Study 2025-26 — Undergraduate Programme Rules",
          "publisher": "IIT Delhi",
          "accessedOn": "2026-09-16",
          "asOf": "2025-26",
          "confidence": "official"
        }
      ],
      "asOf": "2025-26"
    },
    {
      "text": "Minimum registered duration is 8 semesters for B.Tech/B.Des/B.S. and 10 for the dual degree, extendable to 12 or 14 respectively, with a further two-semester slow-paced track available to students who clear fewer credits in their first year.",
      "sources": [
        {
          "url": "https://home.iitd.ac.in/uploads/UG%20Programme%20Rules/CoS-02025-26__UG-Programme-Rules__03-02-2026.pdf",
          "title": "Courses of Study 2025-26 — Undergraduate Programme Rules",
          "publisher": "IIT Delhi",
          "accessedOn": "2026-09-16",
          "asOf": "2025-26",
          "confidence": "official"
        }
      ],
      "asOf": "2025-26"
    }
  ],
  "research": {
    "note": "IIT Delhi holds Institution of Eminence status and runs eleven research centres - spanning atmospheric sciences, biomedical engineering, automotive research and educational technology - alongside six specialised schools covering artificial intelligence, biological sciences, information technology, interdisciplinary research, public policy and telecom technology. As of 2024 it had roughly 4,000 students in doctoral programmes out of about 12,500 students overall, taught by close to 690 faculty.",
    "phdCount": 4004,
