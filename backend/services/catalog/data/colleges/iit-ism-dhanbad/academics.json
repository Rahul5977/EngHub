  "curriculumHighlights": [
    {
      "text": "IIT (ISM) is the only IIT offering full undergraduate tracks in mining, petroleum, applied geology and geophysics, so students in these disciplines study alongside core earth-science departments rather than a bolted-on minor.",
      "sources": [
        {
          "url": "https://www.iitism.ac.in/departments",
          "title": "Departments - IIT (ISM) Dhanbad (Mining, Petroleum, Applied Geology, Applied Geophysics, Fuel-Minerals-Metallurgical Engineering listed as full departments)",
          "publisher": "IIT (ISM) Dhanbad",
          "accessedOn": "2026-09-16",
          "asOf": null,
          "confidence": "official"
        },
        {
          "url": "https://en.wikipedia.org/wiki/IIT_(ISM)_Dhanbad",
          "title": "IIT (ISM) Dhanbad - Wikipedia (only institution of its kind in India with all the earth science branches)",
          "publisher": "Wikipedia",
          "accessedOn": "2026-09-16",
          "asOf": null,
          "confidence": "secondary"
        }
      ],
      "asOf": null
    },
    {
      "text": "A five-year dual-degree track pairs B.Tech Mining Engineering with an MBA in Logistics and Supply Chain Management awarded jointly with IIM Mumbai, combining a technical degree with a management qualification.",
      "sources": [
        {
          "url": "https://www.iitism.ac.in/jeea",
          "title": "JEE (Advanced) / UG Admissions - IIT (ISM) Dhanbad (Dual Degree Programme: B.Tech Mining Engineering + MBA Logistics & SCM, IIM Mumbai)",
          "publisher": "IIT (ISM) Dhanbad",
          "accessedOn": "2026-09-16",
          "asOf": "2026",
          "confidence": "official"
        },
        {
          "url": "https://josaa.admissions.nic.in/applicant/seatmatrix/seatmatrixinfo.aspx",
          "title": "JoSAA 2026 Seat Matrix - Seat Information (Indian Institute of Technology; Mining+MBA dual-degree row)",
          "publisher": "JoSAA",
          "accessedOn": "2026-09-16",
          "asOf": "2026",
          "confidence": "official"
        }
      ],
      "asOf": "2026"
    },
    {
      "text": "Two integrated BS-MS programmes, in Physical Science and Chemical Science, run five years and let students move from a foundational science undergraduate curriculum into a research-oriented master's without a separate entrance test.",
      "sources": [
        {
          "url": "https://www.iitism.ac.in/jeea",
          "title": "JEE (Advanced) / UG Admissions - IIT (ISM) Dhanbad (2 Integrated BS-MS Programmes: Physical Science, Chemical Science)",
          "publisher": "IIT (ISM) Dhanbad",
          "accessedOn": "2026-09-16",
          "asOf": "2026",
          "confidence": "official"
        },
        {
          "url": "https://josaa.admissions.nic.in/applicant/seatmatrix/seatmatrixinfo.aspx",
          "title": "JoSAA 2026 Seat Matrix - Seat Information (Indian Institute of Technology; Physical Science and Chemical Science rows)",
          "publisher": "JoSAA",
          "accessedOn": "2026-09-16",
          "asOf": "2026",
          "confidence": "official"
        }
      ],
      "asOf": "2026"
    },
    {
      "text": "PhD admission stays open through the year across regular institute-assistantship, externally-funded-fellowship and part-time working-professional tracks, reflecting a research programme that runs alongside the taught degrees.",
      "sources": [
        {
          "url": "https://www.iitism.ac.in/phdadmission",
          "title": "PhD Admission - IIT (ISM) Dhanbad (Regular/IA, Externally Funded, Part Time and Special Admission Drive modes; apply throughout the year)",
          "publisher": "IIT (ISM) Dhanbad",
          "accessedOn": "2026-09-16",
          "asOf": null,
          "confidence": "official"
        }
      ],
      "asOf": null
    }
